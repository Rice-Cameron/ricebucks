#!/usr/bin/env bash

# omarchy-budget: CLI companion for the Omarchy Budget & Spending plugin
# Usage:
#   omarchy-budget                       Toggle UI popup
#   omarchy-budget add <amt> <cat>       Add a new purchase
#   omarchy-budget status                Display budget summary
#   omarchy-budget income <amount>       Set monthly income
#   omarchy-budget savings <percent>     Set savings percentage
#   omarchy-budget list                  List recent transactions
#   omarchy-budget categories            List categories
#   omarchy-budget category add <name>   Add category
#   omarchy-budget category rename <old> <new>  Rename category
#   omarchy-budget category delete <name>       Delete category

set -euo pipefail

STATE_FILE="$HOME/.local/state/omarchy/budget.json"

ipc_call() {
  local method="$1"
  shift
  quickshell ipc -p /usr/share/omarchy/shell call cameronri.budget "$method" "$@" 2>/dev/null || true
}

ensure_state_file() {
  if [[ ! -f "$STATE_FILE" ]]; then
    mkdir -p "$(dirname "$STATE_FILE")"
    cat << 'JSON' > "$STATE_FILE"
{
  "version": 1,
  "income": 0,
  "savingsPercent": 20,
  "categories": [
    "Housing",
    "Groceries",
    "Dining Out",
    "Transportation",
    "Utilities",
    "Entertainment",
    "Other"
  ],
  "categoryLimits": {},
  "expenses": []
}
JSON
  fi
}

cmd_toggle() {
  omarchy-shell shell toggle cameronri.budget >/dev/null 2>&1 || true
}

cmd_limit() {
  local category="${1:-}"
  local amount="${2:-}"

  if [[ -z "$category" ]]; then
    echo "Usage: omarchy-budget limit <category> [amount]"
    echo "Example: omarchy-budget limit \"Groceries\" 500"
    echo "         omarchy-budget limit \"Groceries\" clear"
    exit 1
  fi

  if [[ -z "$amount" ]]; then
    ensure_state_file
    local cur_lim
    cur_lim=$(jq -r --arg cat "$category" '(.categoryLimits // {})[$cat] // empty' "$STATE_FILE")
    if [[ -n "$cur_lim" && "$cur_lim" != "null" ]]; then
      printf "Spending limit for '%s': \$%'.2f\n" "$category" "$cur_lim"
    else
      echo "No spending limit set for '$category'."
    fi
    return 0
  fi

  if [[ "$amount" == "clear" || "$amount" == "none" || "$amount" == "remove" || "$amount" == "0" ]]; then
    local res
    res=$(ipc_call setLimit "$category" "0")
    if [[ "$res" != "ok" ]]; then
      ensure_state_file
      jq --arg cat "$category" '
        .categoryLimits = (.categoryLimits // {}) |
        del(.categoryLimits[$cat])
      ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
    fi
    echo "✓ Removed spending limit for '$category'"
    return 0
  fi

  local res
  res=$(ipc_call setLimit "$category" "$amount")
  if [[ "$res" != "ok" ]]; then
    ensure_state_file
    jq --arg cat "$category" --arg amt "$amount" '
      .categoryLimits = (.categoryLimits // {}) |
      .categoryLimits[$cat] = ($amt | tonumber) |
      if (.categories | index($cat)) == null then .categories += [$cat] else . end
    ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi
  echo "✓ Spending limit for '$category' set to \$$amount"
}

cmd_add() {
  local amount="${1:-}"
  local category="${2:-Other}"
  local note="${3:-}"

  if [[ -z "$amount" ]]; then
    echo "Usage: omarchy-budget add <amount> [category] [note]"
    echo "Example: omarchy-budget add 45.50 Groceries \"Trader Joe's\""
    exit 1
  fi

  # Call via IPC if running
  local res
  res=$(ipc_call add "$amount" "$category" "$note")
  if [[ "$res" != "ok" ]]; then
    # Fallback: direct JSON modification
    ensure_state_file
    local now
    now=$(date --iso-8601=seconds)
    local id
    id="$(date +%s)-$RANDOM"

    jq --arg amt "$amount" --arg cat "$category" --arg note "$note" --arg date "$now" --arg id "$id" '
      .expenses = [{id: $id, amount: ($amt | tonumber), category: $cat, note: $note, date: $date}] + .expenses |
      if (.categories | index($cat)) == null then .categories += [$cat] else . end
    ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi

  echo "✓ Added \$$amount to '$category' ($note)"

  # Check category spending limit
  ensure_state_file
  local cur_month
  cur_month=$(date +"%Y-%m")
  local check_res
  check_res=$(jq -r --arg month "$cur_month" --arg cat "$category" '
    def sum_by_cat: [.expenses[] | select(.date | startswith($month)) | select(.category == $cat) | .amount] | add // 0;
    ((.categoryLimits // {})[$cat] // 0) as $lim |
    sum_by_cat as $tot |
    if $lim > 0 then
      if $tot > $lim then
        "OVER\t" + ($tot | tostring) + "\t" + ($lim | tostring) + "\t" + (($tot - $lim) | tostring)
      else
        "OK\t" + ($tot | tostring) + "\t" + ($lim | tostring) + "\t" + (($lim - $tot) | tostring)
      end
    else
      "NONE"
    end
  ' "$STATE_FILE")

  local status tot lim diff
  IFS=$'\t' read -r status tot lim diff <<< "$check_res"
  if [[ "$status" == "OVER" ]]; then
    printf "\033[1;31m⚠ Warning: '%s' spending (\$%'.2f) has exceeded its \$%'.2f limit by \$%'.2f!\033[0m\n" "$category" "$tot" "$lim" "$diff"
  elif [[ "$status" == "OK" ]]; then
    printf "  ('%s' remaining: \$%'.2f of \$%'.2f limit)\n" "$category" "$diff" "$lim"
  fi
}

cmd_income() {
  local amount="${1:-}"
  if [[ -z "$amount" ]]; then
    echo "Usage: omarchy-budget income <amount>"
    exit 1
  fi

  local res
  res=$(ipc_call setIncome "$amount")
  if [[ "$res" != "ok" ]]; then
    ensure_state_file
    jq --arg amt "$amount" '.income = ($amt | tonumber)' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi
  echo "✓ Monthly income set to \$$amount"
}

cmd_savings() {
  local pct="${1:-}"
  if [[ -z "$pct" ]]; then
    echo "Usage: omarchy-budget savings <percent>"
    exit 1
  fi

  local res
  res=$(ipc_call setSavings "$pct")
  if [[ "$res" != "ok" ]]; then
    ensure_state_file
    jq --arg pct "$pct" '.savingsPercent = ($pct | tonumber)' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
  fi
  echo "✓ Savings goal set to ${pct}%"
}

cmd_status() {
  ensure_state_file
  local cur_month
  cur_month=$(date +"%Y-%m")
  local month_name
  month_name=$(date +"%B %Y")

  local data
  data=$(jq -r --arg month "$cur_month" '
    def sum_by_cat(c): [.expenses[] | select(.date | startswith($month)) | select(.category == c) | .amount] | add // 0;
    def total_spent: [.expenses[] | select(.date | startswith($month)) | .amount] | add // 0;
    
    {
      income: (.income // 0),
      savingsPercent: (.savingsPercent // 20),
      savingsTarget: ((.income // 0) * ((.savingsPercent // 20) / 100)),
      totalSpent: total_spent,
      remaining: ((.income // 0) - ((.income // 0) * ((.savingsPercent // 20) / 100)) - total_spent),
      categories: [
        .categories[] as $cat |
        ((.categoryLimits // {})[$cat] // 0) as $lim |
        sum_by_cat($cat) as $tot |
        {
          name: $cat,
          total: $tot,
          limit: $lim,
          isOver: (if $lim > 0 and $tot > $lim then true else false end),
          count: ([.expenses[] | select(.date | startswith($month)) | select(.category == $cat)] | length)
        }
      ] | sort_by(-.total)
    }
  ' "$STATE_FILE")

  local income savings_pct savings_target total_spent remaining
  income=$(echo "$data" | jq -r '.income')
  savings_pct=$(echo "$data" | jq -r '.savingsPercent')
  savings_target=$(echo "$data" | jq -r '.savingsTarget')
  total_spent=$(echo "$data" | jq -r '.totalSpent')
  remaining=$(echo "$data" | jq -r '.remaining')

  echo "=========================================================="
  printf "   $  SPENDING & BUDGET TRACKER  -  %s\n" "$month_name"
  echo "=========================================================="
  printf "  Monthly Income:     \$%'.2f\n" "$income"
  printf "  Savings Goal (%s%%): \$%'.2f\n" "$savings_pct" "$savings_target"
  printf "  Total Spent:        \$%'.2f\n" "$total_spent"
  echo "  --------------------------------------------------------"
  if [[ "$remaining" == -* ]]; then
    printf "  Remaining Budget:  \033[1;31m\$%'.2f (OVER BUDGET!)\033[0m\n" "$remaining"
  else
    printf "  Remaining Budget:  \033[1;32m\$%'.2f\033[0m\n" "$remaining"
  fi
  echo "=========================================================="
  echo "  CATEGORY RUNNING TOTALS:"
  echo "$data" | jq -r --argjson total "$total_spent" '
    .categories[] | 
    select(.total > 0 or .count > 0 or .limit > 0) |
    [
      .name,
      (.total | tostring),
      (.limit | tostring),
      (if .limit > 0 then
        if .isOver then
          "OVER:" + ((.total - .limit) | tostring)
        else
          "UNDER:" + ((.limit - .total) | tostring)
        end
      else
        "NOLIMIT:" + (if $total > 0 then ((.total / $total * 100 * 10 | round) / 10 | tostring) + "%" else "0%" end)
      end),
      (.count | tostring)
    ] | @tsv
  ' | while IFS=$'\t' read -r name tot lim info count; do
    if [[ "$info" =~ ^OVER:(.*) ]]; then
      local over_amt="${BASH_REMATCH[1]}"
      printf "    %-20s \$%8.2f / \$%-8.2f \033[1;31m(OVER LIMIT by \$%'.2f!)\033[0m  [%s tx]\n" "$name" "$tot" "$lim" "$over_amt" "$count"
    elif [[ "$info" =~ ^UNDER:(.*) ]]; then
      local left_amt="${BASH_REMATCH[1]}"
      printf "    %-20s \$%8.2f / \$%-8.2f (%'7.2f left)              [%s tx]\n" "$name" "$tot" "$lim" "$left_amt" "$count"
    else
      local pct="${info#NOLIMIT:}"
      printf "    %-20s \$%8.2f  (%6s of spending)          [%s tx]\n" "$name" "$tot" "$pct" "$count"
    fi
  done
  echo "=========================================================="
}

cmd_list() {
  ensure_state_file
  local filter="${1:-}"
  local cur_month
  cur_month=$(date +"%Y-%m")

  if [[ "$filter" == "all" || "$filter" == "--all" || "$filter" == "-a" ]]; then
    local count
    count=$(jq '.expenses | length' "$STATE_FILE")
    echo "All recorded transactions ($count total):"
    jq -r '
      .expenses[] |
      [
        (.date | split("T")[0]),
        .category,
        (.amount | tostring),
        (.note // "")
      ] | @tsv
    ' "$STATE_FILE" | while IFS=$'\t' read -r dt cat amt note; do
      printf "  %s | %-18s | \$%7.2f | %s\n" "$dt" "$cat" "$amt" "$note"
    done
    return 0
  fi

  echo "Recent transactions for this month:"
  jq -r --arg month "$cur_month" '
    .expenses[] | select(.date | startswith($month)) |
    [
      (.date | split("T")[0]),
      .category,
      (.amount | tostring),
      (.note // "")
    ] | @tsv
  ' "$STATE_FILE" | head -n 15 | while IFS=$'\t' read -r dt cat amt note; do
    printf "  %s | %-18s | \$%7.2f | %s\n" "$dt" "$cat" "$amt" "$note"
  done
}

cmd_category() {
  local sub="${1:-list}"
  shift || true
  ensure_state_file

  case "$sub" in
    list)
      echo "Configured categories:"
      jq -r '
        ((.categoryLimits // {}) as $limits |
        .categories[] |
        [., ($limits[.] // empty)] |
        @tsv)
      ' "$STATE_FILE" | while IFS=$'\t' read -r cat lim; do
        if [[ -n "$lim" ]]; then
          printf "  • %-20s (Limit: \$%'.2f)\n" "$cat" "$lim"
        else
          echo "  • $cat"
        fi
      done
      ;;
    limit|set-limit)
      cmd_limit "$@"
      ;;
    add)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        echo "Usage: omarchy-budget category add <name>"
        exit 1
      fi
      local res
      res=$(ipc_call addCategory "$name")
      if [[ "$res" != "ok" ]]; then
        jq --arg name "$name" '
          if (.categories | index($name)) == null then .categories += [$name] else . end
        ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
      fi
      echo "✓ Added category: $name"
      ;;
    rename)
      local old="${1:-}"
      local new="${2:-}"
      if [[ -z "$old" || -z "$new" ]]; then
        echo "Usage: omarchy-budget category rename <old-name> <new-name>"
        exit 1
      fi
      local res
      res=$(ipc_call renameCategory "$old" "$new")
      if [[ "$res" != "ok" ]]; then
        jq --arg old "$old" --arg new "$new" '
          .categories = [.categories[] | if . == $old then $new else . end] |
          .expenses = [.expenses[] | if .category == $old then .category = $new else . end] |
          .categoryLimits = (.categoryLimits // {}) |
          if .categoryLimits[$old] != null then
            .categoryLimits[$new] = .categoryLimits[$old] | del(.categoryLimits[$old])
          else . end
        ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
      fi
      echo "✓ Renamed category '$old' to '$new'"
      ;;
    delete|remove)
      local name="${1:-}"
      if [[ -z "$name" ]]; then
        echo "Usage: omarchy-budget category delete <name>"
        exit 1
      fi
      local res
      res=$(ipc_call deleteCategory "$name")
      if [[ "$res" != "ok" ]]; then
        jq --arg name "$name" '
          .categories = [.categories[] | select(. != $name)] |
          if (.categories | length) == 0 then .categories = ["Other"] else . end |
          .expenses = [.expenses[] | if .category == $name then .category = "Other" else . end] |
          .categoryLimits = (.categoryLimits // {}) | del(.categoryLimits[$name])
        ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
      fi
      echo "✓ Deleted category '$name' (expenses moved to 'Other')"
      ;;
    move|reorder)
      local from="${1:-}"
      local to="${2:-}"
      if [[ -z "$from" || -z "$to" ]]; then
        echo "Usage: omarchy-budget category move <from-index> <to-index>"
        exit 1
      fi
      local res
      res=$(ipc_call moveCategory "$from" "$to")
      if [[ "$res" != "ok" ]]; then
        jq --argjson from "$from" --argjson to "$to" '
          .categories as $cats |
          if $from >= 0 and $from < ($cats | length) and $to >= 0 and $to < ($cats | length) then
            ($cats[$from]) as $item |
            ([$cats[:$from], $cats[$from+1:]] | flatten) as $rest |
            .categories = ([$rest[:$to], [$item], $rest[$to:]] | flatten)
          else . end
        ' "$STATE_FILE" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
      fi
      echo "✓ Reordered category from index $from to $to"
      ;;
    *)
      echo "Usage: omarchy-budget category [list|add|rename|delete|move|limit] ..."
      ;;
  esac
}

# Subcommand dispatch
action="${1:-toggle}"
shift || true

case "$action" in
  toggle|open|show)
    cmd_toggle
    ;;
  status|overview)
    cmd_status
    ;;
  income)
    cmd_income "$@"
    ;;
  savings|save)
    cmd_savings "$@"
    ;;
  limit)
    cmd_limit "$@"
    ;;
  add|expense|spend)
    cmd_add "$@"
    ;;
  list)
    cmd_list "$@"
    ;;
  transactions|all|view-all)
    ipc_call openTransactions >/dev/null 2>&1 || true
    ;;
  category|categories)
    cmd_category "$@"
    ;;
  *)
    echo "Omarchy Budget & Spending Tracker"
    echo "Usage:"
    echo "  omarchy-budget                       Toggle popup in status bar"
    echo "  omarchy-budget transactions          Open All Transactions window"
    echo "  omarchy-budget add <amount> [cat] [note]  Add purchase"
    echo "  omarchy-budget status                Show terminal overview"
    echo "  omarchy-budget limit <cat> [amount]  Set/view category spending limit"
    echo "  omarchy-budget income <amount>       Set monthly income"
    echo "  omarchy-budget savings <percent>     Set savings goal percent"
    echo "  omarchy-budget list [all]            List purchases (or all transactions)"
    echo "  omarchy-budget categories            List all categories"
    echo "  omarchy-budget category add <name>   Add category"
    echo "  omarchy-budget category rename <old> <new>  Rename category"
    echo "  omarchy-budget category delete <name>       Delete category"
    echo "  omarchy-budget category move <from> <to>    Reorder category"
    echo "  omarchy-budget category limit <cat> <amount> Set category limit"
    ;;
esac
